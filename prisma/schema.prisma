generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String
  image        String?
  timezone     String             @default("Asia/Jakarta")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  completions  WorkoutCompletion[]
  stats        UserStats?

  @@map("users")
}

model DailyChallenge {
  id                String             @id @default(cuid())
  date              String             @unique // Stored as "YYYY-MM-DD"
  title             String
  description       String
  difficulty        String             @default("Intermediate") // Beginner, Intermediate, Advanced
  estimatedDuration Int                // in minutes
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  exercises         ChallengeExercise[]
  completions       WorkoutCompletion[]

  @@index([date])
  @@map("daily_challenges")
}

model Exercise {
  id           String              @id @default(cuid())
  name         String
  description  String
  instructions String              @db.Text
  mediaUrl     String?
  targetMuscle String?
  category     String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  challenges   ChallengeExercise[]

  @@map("exercises")
}

model ChallengeExercise {
  id              String         @id @default(cuid())
  challengeId     String
  exerciseId      String
  order           Int
  sets            Int            @default(3)
  repetitions     Int?
  durationSeconds Int?
  restSeconds     Int?           @default(30)
  challenge       DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  exercise        Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([challengeId, order])
  @@map("challenge_exercises")
}

model WorkoutCompletion {
  id            String         @id @default(cuid())
  userId        String
  challengeId   String
  challengeDate String         // "YYYY-MM-DD" calendar date
  completedAt   DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge     DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@unique([userId, challengeDate])
  @@index([userId, challengeDate])
  @@index([userId, completedAt])
  @@map("workout_completions")
}

model UserStats {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  totalCompletedDays Int      @default(0)
  lastCompletedDate  String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}
